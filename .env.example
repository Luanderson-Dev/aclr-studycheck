# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=uma-senha-segura-aqui
POSTGRES_DB=ponto_db

# Bot API Key (compartilhada com o triplex-bot)
BOT_API_KEY=uma-chave-secreta-compartilhada-com-o-bot

# Discord OAuth
DISCORD_CLIENT_ID=<seu-discord-client-id>
DISCORD_CLIENT_SECRET=<seu-discord-client-secret>
DISCORD_REDIRECT_URI=http://localhost:4200/auth/discord/callback
DISCORD_GUILD_ID=708895475020857386
DISCORD_RH_ROLE_ID=1490528626217586929

# Porta do app (padrão: 80)
APP_PORT=80

# Token do bot do Discord
DISCORD_BOT_TOKEN=uma-chave-secreta-gerada-no-portal-de-desenvolvedores-do-discord

# Kafka
# Bootstrap servers — para apps rodando no host use localhost:9092,
# para apps rodando dentro do compose use kafka:9094
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_HOST_PORT=9092
KAFKA_EXTERNAL_HOST=localhost
KAFKA_UI_PORT=8080
# Consumer group base — sufixos por consumidor (ex.: studycheck-api.sessions)
KAFKA_CONSUMER_GROUP=studycheck-api
