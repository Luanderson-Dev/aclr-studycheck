# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=uma-senha-segura-aqui
POSTGRES_DB=studycheck_db

# JWT
JWT_SEGREDO=UmaChaveSecretaMuitoLongaComNoMinimo256BitsParaHMACSHA256

# Bot API Key (compartilhada com o bot)
BOT_API_KEY=uma-chave-secreta-compartilhada-com-o-bot

# Discord OAuth
DISCORD_CLIENT_ID=<seu-discord-client-id>
DISCORD_CLIENT_SECRET=<seu-discord-client-secret>
DISCORD_REDIRECT_URI=http://localhost:4200/auth/discord/callback
DISCORD_GUILD_ID=<id-do-servidor-de-estudo>
DISCORD_MOD_ROLE_ID=<id-da-role-MOD-no-servidor>

# Token do bot do Discord
DISCORD_BOT_TOKEN=uma-chave-secreta-gerada-no-portal-de-desenvolvedores-do-discord

# Bot — canal de texto onde os logs de voz serão postados
DISCORD_LOG_CHANNEL_ID=<id-do-canal-de-logs>
# Bot — canais de voz monitorados (IDs separados por vírgula). Vazio = todos.
DISCORD_ALLOWED_VOICE_CHANNEL_IDS=

# Bot — owner para sync via DM (opcional)
OWNER_DISCORD_ID=
SECRET_SYNC_TOKEN=

# Cookie HTTPS (true em prod)
APP_SECURITY_COOKIE_SEGURO=false

# Portas expostas
API_PORT=8080
FRONTEND_PORT=4200

# Kafka
# Para apps rodando no host use localhost:9092. Dentro do compose: kafka:9094
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_HOST_PORT=9092
KAFKA_EXTERNAL_HOST=localhost
KAFKA_UI_PORT=8090
KAFKA_CONSUMER_GROUP=studycheck-api
